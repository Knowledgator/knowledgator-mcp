# Knowledgator MCP Server Configuration

# Authentication type: "api_key" (default)
KG_MCP_AUTH_TYPE=api_key

# Knowledgator API Key (KG_MCP_API_KEY or fallback KG_API_KEY)
KG_MCP_API_KEY=your_api_key_here
# KG_API_KEY=your_api_key_here

# Base URL override (KG_MCP_BASE_URL or fallback KG_BASE_URL; default: https://api.platform.knowledgator.com)
KG_MCP_BASE_URL=https://api.platform.knowledgator.com
# KG_BASE_URL=https://api.platform.knowledgator.com

# Server Name
KG_MCP_SERVER_NAME=KnowledgatorMCP

# Debug Mode (true/false)
KG_MCP_DEBUG=false

# Transport Security & DNS Rebinding Protection (enabled by default)
KG_MCP_ENABLE_DNS_PROTECTION=true

# Authorized Host patterns for DNS rebinding protection (comma-separated or JSON list)
# Default already covers localhost, 127.0.0.1, and [::1].
# Add your public domain and internal service/container name:
KG_MCP_ALLOWED_HOSTS="localhost,127.0.0.1,mcp.example.com,mcp-gateway"

# Allowed web origins for browser CORS
# Example: KG_MCP_ALLOWED_ORIGINS="https://chat.example.com,https://app.example.com"
KG_MCP_ALLOWED_ORIGINS=

