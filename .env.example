# Knowledgator MCP Server Configuration

# Authentication type: "api_key" (default)
KG_MCP_AUTH_TYPE=api_key

# Knowledgator API Key (KG_MCP_API_KEY or fallback KG_API_KEY)
KG_MCP_API_KEY=your_api_key_here
# KG_API_KEY=your_api_key_here

# Base URL override (KG_MCP_BASE_URL or fallback KG_BASE_URL; default: https://api.knowledgator.com)
KG_MCP_BASE_URL=https://api.knowledgator.com
# KG_BASE_URL=https://api.knowledgator.com

# Server Name
KG_MCP_SERVER_NAME=KnowledgatorMCP

# Debug Mode (true/false)
KG_MCP_DEBUG=false
